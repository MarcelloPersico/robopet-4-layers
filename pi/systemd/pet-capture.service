[Unit]
Description=Robot desk pet camera + mic capture
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pet
Group=pet
WorkingDirectory=/opt/pet
ExecStart=/opt/pet/venv/bin/python /opt/pet/capture.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
